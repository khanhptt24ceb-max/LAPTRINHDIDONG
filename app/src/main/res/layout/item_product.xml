<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="5dp"
    app:cardCornerRadius="6dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@android:color/white"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1.3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp">

        <!-- Ảnh thumbnail sản phẩm bên trái (Phần B) -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgProduct"
            android:layout_width="86dp"
            android:layout_height="64dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_placeholder"
            android:background="#ECEFF1"
            app:shapeAppearanceOverlay="@style/RoundedCorner8" />

        <!-- Thông tin sản phẩm ở giữa (3 dòng: Tên sp, Giá sp, Loại sp) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/tvTenSp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvGiaSp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:layout_marginTop="4dp"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvLoaiSp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:layout_marginTop="4dp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Nút Sửa (vàng) / Xóa (đỏ) xếp dọc bên phải -->
        <LinearLayout
            android:id="@+id/layoutActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btnEdit"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_edit"
                android:background="@drawable/bg_btn_edit"
                android:contentDescription="Sửa"
                android:padding="7dp"
                android:scaleType="fitCenter"
                app:tint="@color/accent_icon"
                android:layout_marginBottom="6dp" />

            <ImageButton
                android:id="@+id/btnDelete"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_delete"
                android:background="@drawable/bg_btn_delete"
                android:contentDescription="Xóa"
                android:padding="7dp"
                android:scaleType="fitCenter"
                app:tint="@color/danger" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
