<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white">

    <!-- Thanh trạng thái User & Đăng xuất (Phần C) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/primary_light"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp">

        <TextView
            android:id="@+id/tvUserInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Đang tải..."
            android:textSize="12sp"
            android:textColor="@color/primary_dark"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvRoleBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ADMIN"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/badge_admin_text"
            android:background="@color/badge_admin_bg"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:layout_marginEnd="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="0dp"
            android:text="@string/action_logout"
            android:textSize="12sp"
            android:textColor="@color/danger"
            app:icon="@drawable/ic_logout"
            app:iconSize="16dp"
            app:iconTint="@color/danger" />
    </LinearLayout>

    <!-- Tiêu đề chính chuẩn mẫu đề thi -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/title_main"
        android:fontFamily="serif"
        android:textSize="24sp"
        android:textColor="@color/text_primary"
        android:gravity="center"
        android:paddingTop="10dp"
        android:paddingBottom="8dp" />

    <!-- Form nhập liệu (Chỉ hiển thị cho Admin) -->
    <LinearLayout
        android:id="@+id/layoutForm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingBottom="6dp">

        <!-- Ô 1: Tên sản phẩm -->
        <EditText
            android:id="@+id/edtTen"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_input_border"
            android:hint="@string/hint_ten"
            android:paddingHorizontal="12dp"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:inputType="text"
            android:singleLine="true"
            android:layout_marginBottom="8dp" />

        <!-- Ô 2: Loại sản phẩm -->
        <EditText
            android:id="@+id/edtLoai"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_input_border"
            android:hint="@string/hint_loai"
            android:paddingHorizontal="12dp"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:inputType="text"
            android:singleLine="true"
            android:layout_marginBottom="8dp" />

        <!-- Ô 3: Giá sản phẩm -->
        <EditText
            android:id="@+id/edtGia"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_input_border"
            android:hint="@string/hint_gia"
            android:paddingHorizontal="12dp"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:inputType="number"
            android:singleLine="true"
            android:layout_marginBottom="8dp" />

        <!-- Ô 4: Chọn hình ảnh (Phần B) -->
        <LinearLayout
            android:id="@+id/layoutImagePicker"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_input_border"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="10dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/btnPickImage"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_folder"
                android:contentDescription="Chọn ảnh"
                app:tint="#212121" />

            <TextView
                android:id="@+id/tvImageName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="@string/no_image"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:ellipsize="middle"
                android:singleLine="true" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgPreview"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/RoundedCorner8" />
        </LinearLayout>

        <!-- Nút Thêm / Cập nhật + Hủy -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnThem"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/btn_them"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                app:cornerRadius="8dp"
                app:backgroundTint="@color/primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHuy"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:text="@string/btn_huy"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:visibility="gone"
                app:cornerRadius="8dp"
                app:strokeColor="@color/input_stroke" />
        </LinearLayout>

    </LinearLayout>

    <!-- Label Danh sách sản phẩm -->
    <TextView
        android:id="@+id/tvListHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_danh_sach"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:gravity="center"
        android:paddingVertical="8dp" />

    <!-- Empty state -->
    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/empty_list"
        android:textColor="#9E9E9E"
        android:textSize="14sp"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone" />

    <!-- Danh sách RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="10dp"
        android:paddingBottom="10dp"
        android:clipToPadding="false" />

</LinearLayout>
